    IO.print("push-23-endian:" ++ R.state(VM.run([118, 23, 54, 85, 116, 147, 178, 209, 240, 15, 46, 77, 108, 139, 170, 201, 232, 7, 38, 69, 100, 131, 162, 193], 3n)))
    IO.print("push-23-truncated:" ++ R.state(VM.run([118, 254, 254, 254, 254, 254, 254, 254, 254, 254, 254, 254], 3n)))
    IO.print("push-24-endian:" ++ R.state(VM.run([119, 24, 55, 86, 117, 148, 179, 210, 241, 16, 47, 78, 109, 140, 171, 202, 233, 8, 39, 70, 101, 132, 163, 194, 225], 3n)))
    IO.print("push-24-truncated:" ++ R.state(VM.run([119, 254, 254, 254, 254, 254, 254, 254, 254, 254, 254, 254, 254], 3n)))
    IO.print("push-25-endian:" ++ R.state(VM.run([120, 25, 56, 87, 118, 149, 180, 211, 242, 17, 48, 79, 110, 141, 172, 203, 234, 9, 40, 71, 102, 133, 164, 195, 226, 1], 3n)))
