import Base
import ./vm.bend as VM
import ./render.bend as R

def repeat(n: Nat, +byte: U32) -> +List<U32>:
  match n:
    case 0n:
      Nil{}
    case 1n+p:
      byte <> repeat(p, byte)

def main() -> IO(Unit):
  do IO<Unit>:
    IO.print("push-19-truncated:" ++ R.state(VM.run([114, 254, 254, 254, 254, 254, 254, 254, 254, 254], 3n)))
    IO.print("push-20-endian:" ++ R.state(VM.run([115, 20, 51, 82, 113, 144, 175, 206, 237, 12, 43, 74, 105, 136, 167, 198, 229, 4, 35, 66, 97], 3n)))
    IO.print("push-20-truncated:" ++ R.state(VM.run([115, 254, 254, 254, 254, 254, 254, 254, 254, 254, 254], 3n)))
