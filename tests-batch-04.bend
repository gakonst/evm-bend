    IO.print("push-27-endian:" ++ R.state(VM.run([122, 27, 58, 89, 120, 151, 182, 213, 244, 19, 50, 81, 112, 143, 174, 205, 236, 11, 42, 73, 104, 135, 166, 197, 228, 3, 34, 65], 3n)))
