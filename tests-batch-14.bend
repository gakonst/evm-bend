import Base
import ./vm.bend as VM
import ./render.bend as R

def repeat(n: Nat, +byte: U32) -> +List<U32>:
  match n:
    case 0n:
      Nil{}
    case 1n+p:
      byte <> repeat(p, byte)

def main() -> IO(Unit):
  do IO<Unit>:
    IO.print("random-full256-add-62:" ++ R.state(VM.run([127, 236, 15, 101, 148, 143, 183, 8, 197, 168, 177, 223, 79, 192, 175, 68, 223, 162, 51, 86, 105, 77, 208, 111, 209, 49, 104, 200, 190, 236, 110, 173, 2, 127, 247, 163, 189, 141, 42, 187, 37, 167, 72, 239, 195, 149, 252, 228, 161, 156, 12, 57, 231, 224, 31, 91, 238, 14, 172, 218, 204, 49, 70, 95, 34, 143, 1, 0], 9n)))
    IO.print("random-full256-add-63:" ++ R.state(VM.run([127, 134, 112, 237, 33, 99, 69, 228, 98, 72, 224, 67, 19, 151, 62, 220, 194, 190, 160, 41, 56, 171, 17, 178, 68, 231, 168, 124, 21, 73, 43, 57, 208, 127, 20, 206, 254, 18, 49, 20, 24, 83, 158, 225, 190, 192, 146, 161, 137, 114, 212, 136, 77, 47, 173, 204, 204, 125, 1, 32, 125, 167, 117, 219, 10, 217, 1, 0], 100n)))
