# Pure Ethereum Keccak-256 (rate 136 bytes, capacity 512 bits, suffix 0x01).
# Generated by gen_keccak.py: lane index = x + 5*y; each lane is little endian.
# API: hash(+List<U32>) -> W.Word; inputs are masked to bytes.
# Digest bytes form a big-endian integer stored in W.Word little-endian limbs.
import Base
import ../evmword.bend as W

type Lane is Data:
  L{lo: U32, hi: U32}

def xor(a: Lane, b: Lane) -> Lane:
  match a b:
    case L{a, b} L{c, d}:
      L{U32.xor(a, c), U32.xor(b, d)}

def chi(a: Lane, b: Lane, c: Lane) -> Lane:
  match a b c:
    case L{a, b} L{c, d} L{e, f}:
      L{U32.xor(a, U32.and(U32.not(c), e)), U32.xor(b, U32.and(U32.not(d), f))}

def rot0(a: Lane) -> Lane:
  a

def rot1(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(a, 1n), U32.shrn(b, 31n)), U32.or(U32.shln(b, 1n), U32.shrn(a, 31n))}

def rot2(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(a, 2n), U32.shrn(b, 30n)), U32.or(U32.shln(b, 2n), U32.shrn(a, 30n))}

def rot3(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(a, 3n), U32.shrn(b, 29n)), U32.or(U32.shln(b, 3n), U32.shrn(a, 29n))}

def rot6(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(a, 6n), U32.shrn(b, 26n)), U32.or(U32.shln(b, 6n), U32.shrn(a, 26n))}

def rot8(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(a, 8n), U32.shrn(b, 24n)), U32.or(U32.shln(b, 8n), U32.shrn(a, 24n))}

def rot10(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(a, 10n), U32.shrn(b, 22n)), U32.or(U32.shln(b, 10n), U32.shrn(a, 22n))}

def rot14(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(a, 14n), U32.shrn(b, 18n)), U32.or(U32.shln(b, 14n), U32.shrn(a, 18n))}

def rot15(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(a, 15n), U32.shrn(b, 17n)), U32.or(U32.shln(b, 15n), U32.shrn(a, 17n))}

def rot18(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(a, 18n), U32.shrn(b, 14n)), U32.or(U32.shln(b, 18n), U32.shrn(a, 14n))}

def rot20(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(a, 20n), U32.shrn(b, 12n)), U32.or(U32.shln(b, 20n), U32.shrn(a, 12n))}

def rot21(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(a, 21n), U32.shrn(b, 11n)), U32.or(U32.shln(b, 21n), U32.shrn(a, 11n))}

def rot25(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(a, 25n), U32.shrn(b, 7n)), U32.or(U32.shln(b, 25n), U32.shrn(a, 7n))}

def rot27(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(a, 27n), U32.shrn(b, 5n)), U32.or(U32.shln(b, 27n), U32.shrn(a, 5n))}

def rot28(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(a, 28n), U32.shrn(b, 4n)), U32.or(U32.shln(b, 28n), U32.shrn(a, 4n))}

def rot36(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(b, 4n), U32.shrn(a, 28n)), U32.or(U32.shln(a, 4n), U32.shrn(b, 28n))}

def rot39(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(b, 7n), U32.shrn(a, 25n)), U32.or(U32.shln(a, 7n), U32.shrn(b, 25n))}

def rot41(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(b, 9n), U32.shrn(a, 23n)), U32.or(U32.shln(a, 9n), U32.shrn(b, 23n))}

def rot43(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(b, 11n), U32.shrn(a, 21n)), U32.or(U32.shln(a, 11n), U32.shrn(b, 21n))}

def rot44(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(b, 12n), U32.shrn(a, 20n)), U32.or(U32.shln(a, 12n), U32.shrn(b, 20n))}

def rot45(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(b, 13n), U32.shrn(a, 19n)), U32.or(U32.shln(a, 13n), U32.shrn(b, 19n))}

def rot55(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(b, 23n), U32.shrn(a, 9n)), U32.or(U32.shln(a, 23n), U32.shrn(b, 9n))}

def rot56(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(b, 24n), U32.shrn(a, 8n)), U32.or(U32.shln(a, 24n), U32.shrn(b, 8n))}

def rot61(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(b, 29n), U32.shrn(a, 3n)), U32.or(U32.shln(a, 29n), U32.shrn(b, 3n))}

def rot62(a: Lane) -> Lane:
  match a:
    case L{+a, +b}:
      L{U32.or(U32.shln(b, 30n), U32.shrn(a, 2n)), U32.or(U32.shln(a, 30n), U32.shrn(b, 2n))}

type State is Data:
  S{a0: Lane, a1: Lane, a2: Lane, a3: Lane, a4: Lane, a5: Lane, a6: Lane, a7: Lane, a8: Lane, a9: Lane, a10: Lane, a11: Lane, a12: Lane, a13: Lane, a14: Lane, a15: Lane, a16: Lane, a17: Lane, a18: Lane, a19: Lane, a20: Lane, a21: Lane, a22: Lane, a23: Lane, a24: Lane}

def round(s: State, rc: Lane) -> State:
  match s:
    case S{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7, +a8, +a9, +a10, +a11, +a12, +a13, +a14, +a15, +a16, +a17, +a18, +a19, +a20, +a21, +a22, +a23, +a24}:
      +c0 = xor(a0, xor(a5, xor(a10, xor(a15, a20))))
      +c1 = xor(a1, xor(a6, xor(a11, xor(a16, a21))))
      +c2 = xor(a2, xor(a7, xor(a12, xor(a17, a22))))
      +c3 = xor(a3, xor(a8, xor(a13, xor(a18, a23))))
      +c4 = xor(a4, xor(a9, xor(a14, xor(a19, a24))))
      +d0 = xor(c4, rot1(c1))
      +d1 = xor(c0, rot1(c2))
      +d2 = xor(c1, rot1(c3))
      +d3 = xor(c2, rot1(c4))
      +d4 = xor(c3, rot1(c0))
      +b0 = rot0(xor(a0, d0))
      +b10 = rot1(xor(a1, d1))
      +b20 = rot62(xor(a2, d2))
      +b5 = rot28(xor(a3, d3))
      +b15 = rot27(xor(a4, d4))
      +b16 = rot36(xor(a5, d0))
      +b1 = rot44(xor(a6, d1))
      +b11 = rot6(xor(a7, d2))
      +b21 = rot55(xor(a8, d3))
      +b6 = rot20(xor(a9, d4))
      +b7 = rot3(xor(a10, d0))
      +b17 = rot10(xor(a11, d1))
      +b2 = rot43(xor(a12, d2))
      +b12 = rot25(xor(a13, d3))
      +b22 = rot39(xor(a14, d4))
      +b23 = rot41(xor(a15, d0))
      +b8 = rot45(xor(a16, d1))
      +b18 = rot15(xor(a17, d2))
      +b3 = rot21(xor(a18, d3))
      +b13 = rot8(xor(a19, d4))
      +b14 = rot18(xor(a20, d0))
      +b24 = rot2(xor(a21, d1))
      +b9 = rot61(xor(a22, d2))
      +b19 = rot56(xor(a23, d3))
      +b4 = rot14(xor(a24, d4))
      S{xor(chi(b0, b1, b2), rc), chi(b1, b2, b3), chi(b2, b3, b4), chi(b3, b4, b0), chi(b4, b0, b1), chi(b5, b6, b7), chi(b6, b7, b8), chi(b7, b8, b9), chi(b8, b9, b5), chi(b9, b5, b6), chi(b10, b11, b12), chi(b11, b12, b13), chi(b12, b13, b14), chi(b13, b14, b10), chi(b14, b10, b11), chi(b15, b16, b17), chi(b16, b17, b18), chi(b17, b18, b19), chi(b18, b19, b15), chi(b19, b15, b16), chi(b20, b21, b22), chi(b21, b22, b23), chi(b22, b23, b24), chi(b23, b24, b20), chi(b24, b20, b21)}

def permute(s: State) -> State:
  s0 = round(s, L{1, 0})
  s1 = round(s0, L{32898, 0})
  s2 = round(s1, L{32906, 2147483648})
  s3 = round(s2, L{2147516416, 2147483648})
  s4 = round(s3, L{32907, 0})
  s5 = round(s4, L{2147483649, 0})
  s6 = round(s5, L{2147516545, 2147483648})
  s7 = round(s6, L{32777, 2147483648})
  s8 = round(s7, L{138, 0})
  s9 = round(s8, L{136, 0})
  s10 = round(s9, L{2147516425, 0})
  s11 = round(s10, L{2147483658, 0})
  s12 = round(s11, L{2147516555, 0})
  s13 = round(s12, L{139, 2147483648})
  s14 = round(s13, L{32905, 2147483648})
  s15 = round(s14, L{32771, 2147483648})
  s16 = round(s15, L{32770, 2147483648})
  s17 = round(s16, L{128, 2147483648})
  s18 = round(s17, L{32778, 0})
  s19 = round(s18, L{2147483658, 2147483648})
  s20 = round(s19, L{2147516545, 2147483648})
  s21 = round(s20, L{32896, 2147483648})
  s22 = round(s21, L{2147483649, 0})
  s23 = round(s22, L{2147516424, 2147483648})
  s23

def byte_lane(high: Bool, byte: U32, shift: Nat) -> Lane:
  match high:
    case False{}:
      L{U32.shln(byte, shift), 0}
    case True{}:
      L{0, U32.shln(byte, shift)}

def inject_at(i: U32, s: State, v: Lane) -> State:
  match i s:
    case 0 S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}:
      S{xor(a0, v), a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}
    case 1 S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}:
      S{a0, xor(a1, v), a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}
    case 2 S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}:
      S{a0, a1, xor(a2, v), a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}
    case 3 S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}:
      S{a0, a1, a2, xor(a3, v), a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}
    case 4 S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}:
      S{a0, a1, a2, a3, xor(a4, v), a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}
    case 5 S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}:
      S{a0, a1, a2, a3, a4, xor(a5, v), a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}
    case 6 S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}:
      S{a0, a1, a2, a3, a4, a5, xor(a6, v), a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}
    case 7 S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}:
      S{a0, a1, a2, a3, a4, a5, a6, xor(a7, v), a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}
    case 8 S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}:
      S{a0, a1, a2, a3, a4, a5, a6, a7, xor(a8, v), a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}
    case 9 S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}:
      S{a0, a1, a2, a3, a4, a5, a6, a7, a8, xor(a9, v), a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}
    case 10 S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}:
      S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, xor(a10, v), a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}
    case 11 S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}:
      S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, xor(a11, v), a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}
    case 12 S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}:
      S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, xor(a12, v), a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}
    case 13 S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}:
      S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, xor(a13, v), a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}
    case 14 S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}:
      S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, xor(a14, v), a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}
    case 15 S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}:
      S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, xor(a15, v), a16, a17, a18, a19, a20, a21, a22, a23, a24}
    case 16 S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24}:
      S{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, xor(a16, v), a17, a18, a19, a20, a21, a22, a23, a24}
    case _ s:
      s

def inject(s: State, +i: U32, byte: U32) -> State:
  inject_at(U32.div(i, 8), s, byte_lane(U32.is_ge(U32.mod(i, 8), 4), U32.and(byte, 255), U32.to_nat(U32.mul(U32.mod(i, 4), 8))))

def advance(full: Bool, s: State) -> State:
  match full:
    case False{}:
      s
    case True{}:
      permute(s)

def absorb(bytes: +List<U32>, s: State, +i: U32) -> State:
  match bytes:
    case Nil{}:
      permute(inject(inject(s, i, 1), 135, 128))
    case Con{b, tail}:
      absorb(tail, advance(U32.is_eq(i, 135), inject(s, i, b)), U32.mod(U32.add(i, 1), 136))

def swap(+x: U32) -> U32:
  U32.or(U32.or(U32.shln(U32.and(x, 255), 24n), U32.shln(U32.and(U32.shrn(x, 8n), 255), 16n)), U32.or(U32.shln(U32.and(U32.shrn(x, 16n), 255), 8n), U32.shrn(x, 24n)))

def digest(s: State) -> W.Word:
  match s:
    case S{L{a, b}, L{c, d}, L{e, f}, L{g, h}, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _}:
      W.W{swap(h), swap(g), swap(f), swap(e), swap(d), swap(c), swap(b), swap(a)}

def hash(bytes: +List<U32>) -> W.Word:
  digest(absorb(bytes, S{L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}, L{0, 0}}, 0))
