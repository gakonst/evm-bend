import Base
import ./evmword.bend as L
import ./word-spec.bend as S

# Concrete refinement checks, not a universally quantified refinement proof.
def x0() -> L.Word:
  L.W{4294967295,4294967295,4294967295,4294967295,4294967295,4294967295,4294967295,4294967295}
def y0() -> L.Word:
  L.W{1,0,0,0,0,0,0,0}
law refine_0:
  {S.of_limbs(L.add(x0(),y0())) == S.add(S.of_limbs(x0()),S.of_limbs(y0())) : S.Word256}
def refine_0():
  {==}

